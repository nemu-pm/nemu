+// nemu patch: `scrollEdgeEffects` used to reach only the scroll view found by
+// walking `subviews[0]` from the screen, once, when the screen was pushed or
+// its props changed. A page whose ScrollView is not the first subview (any
+// sibling before it: a sheet host, an overlay) or that mounts / remounts its
+// ScrollView later (skeleton -> content, a `key` change) kept UIKit's
+// `automatic` style, which draws the hard band + dividing line under the
+// navigation bar. Apply to the first-chain scroll view as before, plus every
+// React ScrollView of this screen that is not nested in another ScrollView or
+// in a nested screen / navigator (those own their own settings), and re-apply
+// whenever a mounting transaction inserts a ScrollView.
+static BOOL RNSIsNestedScrollEdgeEffectBoundary(UIView *view)
+{
+  if ([view isKindOfClass:RNSScreenView.class] || [view isKindOfClass:RNSScreenStackView.class] ||
+      [view isKindOfClass:RNSScreenContainerView.class] || [view isKindOfClass:RNSScreenStackHeaderConfig.class]) {
+    return YES;
+  }
+  NSString *className = NSStringFromClass(view.class);
+  return [className hasPrefix:@"RNSTabs"] || [className hasPrefix:@"RNSSplit"];
+}
+
+static void RNSCollectContentScrollViews(UIView *view, NSMutableArray<UIScrollView *> *scrollViews)
+{
+  for (UIView *subview in view.subviews) {
+    if ([subview isKindOfClass:UIScrollView.class]) {
+      if ([subview.superview isKindOfClass:RCTScrollViewComponentView.class] &&
+          ![scrollViews containsObject:(UIScrollView *)subview]) {
+        [scrollViews addObject:(UIScrollView *)subview];
+      }
+      continue;
+    }
+    if (RNSIsNestedScrollEdgeEffectBoundary(subview)) {
+      continue;
+    }
+    RNSCollectContentScrollViews(subview, scrollViews);
+  }
+}
+
+- (BOOL)hasCustomScrollEdgeEffects
+{
+  return self.topScrollEdgeEffect != RNSScrollEdgeEffectAutomatic ||
+      self.bottomScrollEdgeEffect != RNSScrollEdgeEffectAutomatic ||
+      self.leftScrollEdgeEffect != RNSScrollEdgeEffectAutomatic ||
+      self.rightScrollEdgeEffect != RNSScrollEdgeEffectAutomatic;
+}
+
 - (void)updateContentScrollViewEdgeEffectsIfExists
 {
-  [RNSScrollEdgeEffectApplicator applyToScrollView:[RNSScrollViewFinder findScrollViewInFirstDescendantChainFrom:self]
-                                      withProvider:self];
+  NSMutableArray<UIScrollView *> *scrollViews = [NSMutableArray new];
+  UIScrollView *firstChainScrollView = [RNSScrollViewFinder findScrollViewInFirstDescendantChainFrom:self];
+  if (firstChainScrollView != nil) {
+    [scrollViews addObject:firstChainScrollView];
+  }
+  if ([self hasCustomScrollEdgeEffects]) {
+    RNSCollectContentScrollViews(self, scrollViews);
+  }
+  for (UIScrollView *scrollView in scrollViews) {
+    [RNSScrollEdgeEffectApplicator applyToScrollView:scrollView withProvider:self];
+  }
+}
+
+#pragma mark - RCTMountingTransactionObserving
+
+- (void)mountingTransactionDidMount:(const facebook::react::MountingTransaction &)transaction
+               withSurfaceTelemetry:(const facebook::react::SurfaceTelemetry &)surfaceTelemetry
+{
+  if (![self hasCustomScrollEdgeEffects]) {
+    return;
+  }
+  for (const auto &mutation : transaction.getMutations()) {
+    if (mutation.type == react::ShadowViewMutation::Insert && mutation.newChildShadowView.componentName != nullptr &&
+        std::strcmp(mutation.newChildShadowView.componentName, "ScrollView") == 0) {
+      [self updateContentScrollViewEdgeEffectsIfExists];
+      return;
+    }
+  }
 }
 
