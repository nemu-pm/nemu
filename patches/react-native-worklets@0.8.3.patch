 }
 
@@ -388,4 +396,30 @@ afterEvaluate {
         it.finalizedBy(cleanCMakeCache)
     }
 }
-
+// Preserve the community JSC Prefab headers until every Worklets native-clean
+// task has consumed them. The app's global clean topology deletes project
+// outputs only after all native-clean tasks have completed.
+gradle.projectsEvaluated {
+    if (JS_RUNTIME != "jsc") return
+    def jscProject = rootProject.findProject(":react-native-community_javascriptcore")
+    if (jscProject == null) return
+
+    def jscHeaders = jscProject.tasks.named("createPrefabHeadersDir")
+    def jscDebugBuild = jscProject.tasks.named("buildCMakeDebug")
+    def jscReleaseBuild = jscProject.tasks.named("buildCMakeRelWithDebInfo")
+    tasks.matching { task ->
+        task.name.startsWith("buildCMakeDebug")
+    }.configureEach {
+        dependsOn(jscDebugBuild)
+    }
+    tasks.matching { task ->
+        task.name.startsWith("buildCMakeRelWithDebInfo")
+    }.configureEach {
+        dependsOn(jscReleaseBuild)
+    }
+    tasks.matching { task ->
+        task.name.startsWith("externalNativeBuildClean")
+    }.configureEach {
+        dependsOn(jscHeaders)
+    }
+}
