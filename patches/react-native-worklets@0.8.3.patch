     if (JS_RUNTIME == "hermes") {
         implementation "com.facebook.react:hermes-android" // version substituted by RNGP
+    } else if (JS_RUNTIME == "jsc" && rootProject.findProject(":react-native-community_javascriptcore") != null) {
