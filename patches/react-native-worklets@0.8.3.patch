diff --git a/android/CMakeLists.txt b/android/CMakeLists.txt
index 120f2ceb..5bbedcfd 100644
--- a/android/CMakeLists.txt
+++ b/android/CMakeLists.txt
@@ -63,6 +63,21 @@ find_package(ReactAndroid REQUIRED CONFIG)
 
 if(${JS_RUNTIME} STREQUAL "hermes")
   find_package(hermes-engine REQUIRED CONFIG)
+elseif(${JS_RUNTIME} STREQUAL "jsc")
+  find_package(react-native-community_javascriptcore REQUIRED CONFIG)
+  if(DEFINED NEMU_JSC_RUNTIME_FACTORY_BUILD_DIR)
+    if(CMAKE_BUILD_TYPE STREQUAL "Debug")
+      set(NEMU_JSC_RUNTIME_FACTORY_VARIANT "debug")
+    else()
+      set(NEMU_JSC_RUNTIME_FACTORY_VARIANT "release")
+    endif()
+    add_library(nemu_jsc_runtime_factory SHARED IMPORTED)
+    set_target_properties(
+      nemu_jsc_runtime_factory
+      PROPERTIES
+        IMPORTED_LOCATION
+        "${NEMU_JSC_RUNTIME_FACTORY_BUILD_DIR}/intermediates/cmake/${NEMU_JSC_RUNTIME_FACTORY_VARIANT}/obj/${ANDROID_ABI}/libjscruntimefactory.so")
+  endif()
 endif()
 
 add_library(worklets SHARED ${WORKLETS_COMMON_CPP_SOURCES}
@@ -112,5 +127,11 @@ if(${JS_RUNTIME} STREQUAL "hermes")
     target_link_libraries(worklets ReactAndroid::hermestooling)
   endif()
 elseif(${JS_RUNTIME} STREQUAL "jsc")
-  target_link_libraries(worklets ReactAndroid::jsctooling)
+  target_link_libraries(worklets react-native-community_javascriptcore::jscruntimefactory)
+  if(TARGET nemu_jsc_runtime_factory)
+    # AGP exposes local-project Prefab dependencies as header-only snapshots.
+    # Link the producer's stable native output explicitly while retaining the
+    # Prefab target above for its exported headers.
+    target_link_libraries(worklets nemu_jsc_runtime_factory)
+  endif()
 endif()
