{
  "name": "@nemu/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-background-task"
        ]
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "ocr:models": "bun modules/nemu-japanese-learning/scripts/fetch-ocr-models.ts",
    "lint": "expo lint",
    "test": "bun test --test-name-pattern '^(?!.*(?:checked-in bundle reproducible|Swift native policy executables)).*$' && bun test ./src/sources/mobileAidokuSandboxBundle.contract.test.ts ./src/sources/mobileNativeHttpSsrfPolicy.test.ts --test-name-pattern '(checked-in bundle reproducible|Swift native policy executables)'",
    "build:ios:production": "eas build --platform ios --profile production",
    "build:android:production": "eas build --platform android --profile production"
  },
  "dependencies": {
    "@better-auth/expo": "1.6.23",
    "@convex-dev/better-auth": "0.12.5",
    "@expo/material-symbols": "^0.1.1",
    "@expo/ui": "~58.0.7",
    "@expo/vector-icons": "^15.0.2",
    "@nemu.pm/aidoku-runtime": "^0.11.0",
    "@nemu/core": "workspace:*",
    "@react-native-community/javascriptcore": "^0.2.0",
    "@shopify/react-native-skia": "2.11.2",
    "better-auth": "1.6.23",
    "convex": "^1.31.2",
    "expo": "58.0.0-preview.7",
    "expo-asset": "~58.0.7",
    "expo-audio": "~58.0.2",
    "expo-background-task": "~58.0.7",
    "expo-blur": "~58.0.1",
    "expo-clipboard": "~58.0.1",
    "expo-constants": "~58.0.7",
    "expo-crypto": "~58.0.2",
    "expo-document-picker": "~58.0.1",
    "expo-file-system": "~58.0.2",
    "expo-font": "~58.0.2",
    "expo-haptics": "~58.0.1",
    "expo-image-picker": "~58.0.7",
    "expo-keep-awake": "~58.0.1",
    "expo-linear-gradient": "~58.0.1",
    "expo-linking": "~58.0.7",
    "expo-localization": "~58.0.1",
    "expo-network": "~58.0.1",
    "expo-router": "~58.0.8",
    "expo-screen-orientation": "~58.0.0",
    "expo-secure-store": "~58.0.0",
    "expo-speech-recognition": "57.1.0",
    "expo-splash-screen": "~58.0.1",
    "expo-sqlite": "~58.0.6",
    "expo-status-bar": "~58.0.1",
    "expo-system-ui": "~58.0.2",
    "expo-task-manager": "~58.0.8",
    "expo-web-browser": "~58.0.2",
    "fflate": "^0.8.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0-rc.1",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.13.0",
    "unorm": "1.6.0",
    "whatwg-url-minimum": "0.1.2"
  },
  "devDependencies": {
    "@babel/plugin-transform-logical-assignment-operators": "7.29.7",
    "@babel/plugin-transform-nullish-coalescing-operator": "7.29.7",
    "@babel/plugin-transform-optional-chaining": "7.29.7",
    "@better-fetch/fetch": "1.3.1",
    "@types/bun": "^1.3.5",
    "@types/react": "~19.3.0",
    "@types/unorm": "1.3.31",
    "babel-preset-expo": "~58.0.0",
    "dotenv": "^17.4.2",
    "typescript": "~6.0.3"
  }
}
