{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": [
      "bun"
    ],
    "paths": {
      "@nemu/core": [
        "../../packages/core/src/index.ts"
      ],
      "@nemu/core/*": [
        "../../packages/core/src/*"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  // Expo CLI regenerates expo-env.d.ts with RN Web ambient types. Those
  // widen native styles (e.g. position: fixed/sticky), conflicting with
  // RN 0.88's strict native props. Use src/types/expo-native.d.ts instead.
  "exclude": ["node_modules", "android", "ios", "expo-env.d.ts"],
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "expo-env.d.ts",
    ".expo/types/**/*.ts"
  ]
}
