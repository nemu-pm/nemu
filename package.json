{
  "name": "nemu",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "bun scripts/patch-aidoku-runtime.ts && bun scripts/patch-vaul-css.ts",
    "dev": "concurrently \"vite --host\" \"convex dev\"",
    "mobile:dev": "bun run --filter @nemu/mobile start",
    "mobile:typecheck": "bun run --filter @nemu/mobile typecheck",
    "generate:mobile-app-icon-glow": "bun scripts/generate-mobile-app-icon-glow.ts",
    "generate:mobile-aidoku-sandbox": "bun scripts/patch-aidoku-runtime.ts && bun scripts/build-mobile-aidoku-sandbox.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "core:typecheck": "tsc -p packages/core/tsconfig.json",
    "core:test": "bun run --cwd packages/core test",
    "typecheck": "bun run core:typecheck && tsc -b --noEmit && tsc -p convex --noEmit",
    "preview": "vite preview",
    "test": "bun test && bun test ./tests && bun run core:test",
    "test:coverage": "bun test --coverage && bun test ./tests --coverage && bun run core:test --coverage",
    "service": "bun services/proxy/dev.ts",
    "generate:apple-secret": "tsx scripts/generate-apple-secret.ts",
    "predeploy": "bun run generate:apple-secret",
    "deploy": "bun run predeploy && convex deploy"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.96",
