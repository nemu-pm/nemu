# Keep deterministic build outputs committed while making review tooling treat
# them as generated. Their source files and regeneration scripts remain normal
# review targets.
convex/_generated/** linguist-generated=true

# Unified diffs require leading marker characters on every hunk line. Context
# lines therefore contain a marker space before their original indentation;
# exclude those patch-format bytes from source-oriented whitespace checks.
patches/*.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
